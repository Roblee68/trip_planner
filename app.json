{
  "expo": {
    "name": "PB&B",
    "slug": "pb-and-b",
    "scheme": "pbandb",
    "version": "0.1.0",
    "icon": "./assets/detours-app-icon-teal.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/detours-app-icon-teal.png",
      "usesAppleSignIn": true,
      "buildNumber": "2",
      "supportsTablet": true,
      "bundleIdentifier": "com.roblee.pbandb",
      "deploymentTarget": "16.4"
    },
    "android": {
      "icon": "./assets/detours-app-icon-teal.png",
      "versionCode": 2,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/detours-android-adaptive.png",
        "backgroundColor": "#18B8B0"
      },
      "package": "com.roblee.pbandb"
    },
    "web": {
      "name": "PB&B"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true,
            "usePrecompiledModules": false
          }
        }
      ],
      "./plugins/withPodMinimum",
      "./plugins/withAndroidGoogleServicesOnly",
      "expo-apple-authentication",
      "expo-status-bar",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow PB&B to find your nearby city and suggest experiences when you ask."
        }
      ],
      "./plugins/withLocalNotificationsOnly",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Detours & Escapades to choose a photo or screenshot you ask it to save.",
          "microphonePermission": false
        }
      ],
      [
        "expo-calendar",
        {
          "writeOnlyAccess": true,
          "writeOnlyCalendarPermission": "Allow Detours & Escapades to add a find to your calendar when you choose."
        }
      ],
      "./plugins/withFriendlyShareName",
      [
        "expo-sharing",
        {
          "ios": {
            "enabled": true,
            "appGroupId": "group.com.roblee.pbandb",
            "activationRule": {
              "supportsText": true,
              "supportsWebUrlWithMaxCount": 1,
              "supportsImageWithMaxCount": 1
            }
          },
          "android": {
            "enabled": true,
            "singleShareMimeTypes": [
              "text/plain",
              "image/*"
            ]
          }
        }
      ]
    ]
  }
}
