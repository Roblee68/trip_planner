{
  "expo": {
    "name": "PB&B",
    "slug": "pb-and-b",
    "scheme": "pbandb",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.roblee.pbandb",
      "deploymentTarget": "16.4"
    },
    "android": {
      "package": "com.roblee.pbandb"
    },
    "web": {
      "name": "PB&B"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      "./plugins/withPodMinimum",
      "expo-status-bar",
      ["expo-location", { "locationWhenInUsePermission": "Allow PB&B to find your nearby city and suggest experiences when you ask." }],
      "./plugins/withLocalNotificationsOnly"
    ]
  }
}
