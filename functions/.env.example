# Shared catalogue browsing; only centralized collection and explicit routes use AI.
PBB_SCOUT_MODE=catalogue
PBB_WEB_MODEL=gpt-6-luna
PBB_IMPORT_MODEL=gpt-6-luna
PBB_DISCOVERY_MODE=catalogue

# Photon-compatible endpoint; may be switched server-side without an app update.
PBB_GEOCODER_BASE_URL=https://photon.komoot.io
